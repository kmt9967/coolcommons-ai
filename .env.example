# Optional: enables live AI planning via Alibaba Cloud Model Studio (Qwen), OpenAI-compatible endpoint.
# Without it, the app uses its clearly-labelled rules-based planning engine.
DASHSCOPE_API_KEY=your-key-here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
